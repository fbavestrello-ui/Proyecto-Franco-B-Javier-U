---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = "https://ingenieria-informatica-utem.vercel.app";
import '../styles/global.css';
---

<!doctype html>
<html lang="es-CL" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Logoutem.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Metadatos Primarios y SEO Estricto -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="UTEM - Universidad Tecnológica Metropolitana" />
    <meta property="og:image" content="/Logoutem.png" />
  </head>
  <body class="bg-[#f8fafc] text-slate-800 antialiased flex flex-col min-h-screen">

    <!-- Franja Superior de Identidad Estatal de Chile (Idéntica a la barra tricolor de utem.cl) -->
    <div class="h-1.5 w-full flex">
      <div class="h-full w-1/2 bg-[#004b93]"></div>
      <div class="h-full w-1/2 bg-[#e02424]"></div>
    </div>

    <!-- Barra de Accesos Rápidos (Estilo Portal UTEM) -->
    <div class="bg-white text-slate-500 text-xs py-2 px-4 border-b border-slate-100 hidden md:block">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-4">
          <span class="text-slate-700 font-medium">Universidad del Estado de Chile &bull; CRUCH / CUECH</span>
          <span class="text-slate-300">|</span>
          <span class="text-slate-600">Acreditación Nivel Avanzado CNA-Chile</span>
        </div>
        <div class="flex items-center gap-5 text-xs font-medium text-slate-600">
          <a href="#referencias" class="hover:text-[#004b93] transition">Matriz de Fuentes APA 7</a>
          <span class="text-slate-300">|</span>
          <span class="text-[#004b93] font-semibold">Campus Macul</span>
        </div>
      </div>
    </div>

    <!-- Toolbar Principal BLANCA y LIMPIA (El logo encaja perfecto sin parches) -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Logo Oficial UTEM Integrado de Forma Impecable sobre Blanco -->
        <a href="#hero" class="flex items-center gap-4 group focus:outline-none focus:ring-2 focus:ring-[#004b93] rounded-lg p-1" aria-label="Inicio UTEM Ingeniería en Informática">
          <img src="/Logoutem.png" alt="Universidad Tecnológica Metropolitana" width="180" height="48" class="h-12 sm:h-14 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]" fetchpriority="high" />
          <div class="hidden lg:flex flex-col border-l border-slate-200 pl-4 py-0.5">
            <span class="text-[11px] font-bold uppercase tracking-wider text-[#004b93]">Ingeniería en Informática</span>
            <span class="text-xs text-slate-500 font-medium">Facultad de Ingeniería &bull; 8 Semestres</span>
          </div>
        </a>

        <!-- Menú de Navegación con la Tipografía y Estilo de utem.cl -->
        <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-7 text-sm font-semibold text-[#1b365d]">
          <a href="#sobre-la-carrera" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Diferenciación</a>
          <a href="#perfil-egreso" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Perfil</a>
          <a href="#plan-estudios" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Malla Curricular</a>
          <a href="#campo-laboral" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Empleabilidad</a>
          <a href="#respaldo-institucional" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Acreditación</a>
          <a href="#admision" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Admisión</a>
          <a href="#faq" class="hover:text-[#004b93] transition-colors py-1 border-b-2 border-transparent hover:border-[#004b93]">Preguntas</a>
          
          <a href="#referencias" class="px-4 py-2 rounded-full bg-[#004b93] hover:bg-[#003870] text-white text-xs font-bold transition shadow-sm hover:shadow-md">
            Fuentes APA 7
          </a>
        </nav>

        <!-- Botón Menú Móvil -->
        <button id="mobile-menu-btn" type="button" class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-[#004b93] hover:bg-slate-100 transition" aria-label="Abrir menú de navegación" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <!-- Menú Desplegable Móvil -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white">
        <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-2 text-sm font-semibold text-[#1b365d]">
          <a href="#sobre-la-carrera" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Diferenciación con Civil</a>
          <a href="#perfil-egreso" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Perfil de Egreso</a>
          <a href="#plan-estudios" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Malla Curricular (240 SCT)</a>
          <a href="#campo-laboral" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Empleabilidad e Ingresos</a>
          <a href="#respaldo-institucional" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Acreditación CNA</a>
          <a href="#admision" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Admisión DEMRE</a>
          <a href="#faq" class="px-3 py-2 rounded-lg hover:bg-slate-50 hover:text-[#004b93]">Preguntas Frecuentes</a>
          <a href="#referencias" class="px-3 py-2.5 rounded-full bg-[#004b93] text-white text-center font-bold mt-2">Fuentes APA 7</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Institucional Estilo UTEM (Limpio, formal y fidedigno) -->
    <footer class="bg-[#1b365d] text-slate-300 pt-16 pb-8 border-t border-slate-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-slate-700/80">
          
          <!-- Bloque Logo UTEM con contenedor blanco redondeado para nitidez absoluta -->
          <div class="md:col-span-5">
            <div class="bg-white p-3.5 rounded-2xl inline-block shadow-md mb-5">
              <img src="/Logoutem.png" alt="Universidad Tecnológica Metropolitana" width="160" height="48" loading="lazy" class="h-12 w-auto object-contain" />
            </div>
            <p class="text-xs leading-relaxed text-slate-300 mb-3">
              Carrera de <strong>Ingeniería en Informática</strong> (8 semestres, 240 SCT). Departamento de Informática y Computación, Facultad de Ingeniería.
            </p>
            <p class="text-xs text-slate-400">
              <strong class="text-white">Campus Macul:</strong> Av. José Pedro Alessandri 1242, Ñuñoa, Santiago de Chile.
            </p>
            <p class="text-[11px] text-slate-400 mt-4 border-t border-slate-700 pt-3 italic">
              *Crédito institucional: Identidad visual corporativa propiedad de la Universidad Tecnológica Metropolitana, utilizada con fines docentes en la asignatura EFE685.
            </p>
          </div>

          <div class="md:col-span-2">
            <h2 class="text-xs uppercase tracking-wider font-bold text-white mb-4 border-l-2 border-[#78be20] pl-2">Secciones</h2>
            <ul class="space-y-2.5 text-xs text-slate-300">
              <li><a href="#sobre-la-carrera" class="hover:text-white transition">Diferenciación</a></li>
              <li><a href="#perfil-egreso" class="hover:text-white transition">Perfil Egreso</a></li>
              <li><a href="#plan-estudios" class="hover:text-white transition">Malla Curricular</a></li>
              <li><a href="#campo-laboral" class="hover:text-white transition">Empleabilidad</a></li>
              <li><a href="#admision" class="hover:text-white transition">Admisión</a></li>
              <li><a href="#referencias" class="hover:text-white transition">Fuentes APA 7</a></li>
            </ul>
          </div>

          <div class="md:col-span-3">
            <h2 class="text-xs uppercase tracking-wider font-bold text-white mb-4 border-l-2 border-[#0077c8] pl-2">Proyecto Académico</h2>
            <p class="text-xs leading-relaxed text-slate-300 mb-2">
              Asignatura EFE685 &mdash; Electivo de Computación Móvil (2026).
            </p>
            <p class="text-xs text-slate-300"><strong class="text-white">Integrantes:</strong> Franco Bavestrello, Javier Urbina</p>
            <p class="text-xs text-slate-300"><strong class="text-white">Docente:</strong> Sebastián Salazar Molina</p>
            <div class="mt-4 p-2.5 rounded-xl bg-white/5 border border-white/10 text-[11px] text-slate-300">
              Sitio desarrollado con Astro + TypeScript strict y Content Collections Zod.
            </div>
          </div>

          <div class="md:col-span-2">
            <h2 class="text-xs uppercase tracking-wider font-bold text-white mb-4 border-l-2 border-emerald-400 pl-2">Estándares Web</h2>
            <ul class="space-y-2 text-xs text-slate-300">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> WCAG 2.2 AA</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#0077c8]"></span> Lighthouse 90+</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#78be20]"></span> 0 JS innecesario</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Fuentes APA 7</li>
            </ul>
          </div>
        </div>

        <div class="pt-6 text-center text-[11px] text-slate-400">
          &copy; 2026 Universidad Tecnológica Metropolitana &mdash; Facultad de Ingeniería. Todos los derechos reservados.
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden');
        });
        menu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
