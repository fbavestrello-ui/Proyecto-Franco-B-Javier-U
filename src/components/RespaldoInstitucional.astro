---
// Sección Respaldo Institucional con cabeceras degradadas azul-verde e iconos oficiales UTEM
---
<section id="respaldo-institucional" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-blue-100 text-[#004b93] text-xs font-black uppercase tracking-wider mb-3">
      Garantías y Respaldo
    </div>
    <h2 class="text-3xl sm:text-5xl font-black text-[#1b365d] tracking-tight">
      ¿Qué respaldo institucional tiene la carrera?
    </h2>
    <div class="w-24 h-1 bg-[#78be20] mx-auto mt-4 rounded-full"></div>
    <p class="mt-4 text-slate-600 text-sm sm:text-base leading-relaxed">
      Estudia en una universidad pública del Consejo de Rectores (CRUCH) y del Consorcio de Universidades del Estado de Chile (CUECH).
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Card 1: Acreditación CNA con cabecera degradada oficial UTEM -->
    <div class="utem-featured-card flex flex-col justify-between group">
      <div>
        <!-- Banner superior degradado con icono blanco redondeado idéntico a utem.cl -->
        <div class="utem-banner-gradient-1 p-6 h-28 flex items-center">
          <div class="utem-icon-badge group-hover:scale-105 transition-transform">
            <!-- Icono de Certificación / Acreditación con Lupa (como el de la imagen de utem.cl) -->
            <svg class="w-7 h-7 text-[#004b93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
              <circle cx="16.5" cy="16.5" r="3" stroke="#78be20" stroke-width="2"/>
              <path d="M18.5 18.5L21 21" stroke="#78be20" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="ml-4 text-white">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-200 block">Certificación Pública</span>
            <span class="text-base font-black tracking-tight text-white">Acreditación CNA</span>
          </div>
        </div>

        <!-- Contenido -->
        <div class="p-7">
          <div class="inline-block px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase mb-3">
            4 Años &bull; Nivel Avanzado
          </div>
          <h3 class="font-extrabold text-[#1b365d] text-lg mb-2">Acreditación Institucional</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Certificada por la <strong>Comisión Nacional de Acreditación (CNA-Chile)</strong> en Gestión Institucional y Docencia de Pregrado. Garantiza el acceso a <strong>Gratuidad Universitaria</strong> y beneficios estudiantiles del Estado.
          </p>
        </div>
      </div>

      <div class="p-6 pt-0 border-t border-slate-100 flex items-center justify-between text-xs mt-4">
        <span class="text-slate-500 font-medium">Resolución CNA</span>
        <a href="#referencias" class="text-[#004b93] font-bold hover:underline" title="Fuente F03">[F03: CNA-Chile]</a>
      </div>
    </div>

    <!-- Card 2: Campus Macul y Laboratorios con cabecera degradada oficial UTEM -->
    <div class="utem-featured-card flex flex-col justify-between group">
      <div>
        <div class="utem-banner-gradient-2 p-6 h-28 flex items-center">
          <div class="utem-icon-badge group-hover:scale-105 transition-transform">
            <!-- Icono de Redes y Conexiones Tecnológicas (como el de la imagen de utem.cl) -->
            <svg class="w-7 h-7 text-[#004b93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="3" stroke="#004b93" stroke-width="2"/>
              <circle cx="4" cy="12" r="2" stroke="#78be20" stroke-width="2"/>
              <circle cx="20" cy="12" r="2" stroke="#78be20" stroke-width="2"/>
              <circle cx="12" cy="4" r="2" stroke="#78be20" stroke-width="2"/>
              <circle cx="12" cy="20" r="2" stroke="#78be20" stroke-width="2"/>
              <path d="M6 12h3M15 12h3M12 6v3M12 15v3" stroke="#004b93" stroke-width="2"/>
            </svg>
          </div>
          <div class="ml-4 text-white">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-200 block">Infraestructura</span>
            <span class="text-base font-black tracking-tight text-white">Campus Macul</span>
          </div>
        </div>

        <div class="p-7">
          <div class="inline-block px-2.5 py-1 rounded-full bg-blue-50 text-[#004b93] border border-blue-200 text-xs font-bold uppercase mb-3">
            Facultad de Ingeniería
          </div>
          <h3 class="font-extrabold text-[#1b365d] text-lg mb-2">Laboratorios Especializados</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Instalaciones equipadas en Campus Macul: laboratorios con estaciones para desarrollo en Linux/Windows, laboratorios de redes Cisco y servidores dedicados del Departamento de Informática y Computación.
          </p>
        </div>
      </div>

      <div class="p-6 pt-0 border-t border-slate-100 flex items-center justify-between text-xs mt-4">
        <span class="text-slate-500 font-medium">Catálogo Departamental</span>
        <a href="#referencias" class="text-[#004b93] font-bold hover:underline" title="Fuente F07">[F07: Fac. Ing]</a>
      </div>
    </div>

    <!-- Card 3: Cuerpo Académico con cabecera degradada oficial UTEM -->
    <div class="utem-featured-card flex flex-col justify-between group">
      <div>
        <div class="utem-banner-gradient-3 p-6 h-28 flex items-center">
          <div class="utem-icon-badge group-hover:scale-105 transition-transform">
            <!-- Icono de Integración / Piezas de Rompecabezas (como el de la imagen de utem.cl) -->
            <svg class="w-7 h-7 text-[#004b93]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v.163a.75.75 0 01-.75.75h-.163c-.355 0-.676-.186-.959-.401-.29-.221-.634-.349-1.003-.349-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401h.163a.75.75 0 01.75.75v.163c0 .355-.186.676-.401.959-.221.29-.349.634-.349 1.003 0 1.036 1.007 1.875 2.25 1.875s2.25-.84 2.25-1.875c0-.369-.128-.713-.349-1.003-.215-.283-.401-.604-.401-.959v-.163a.75.75 0 01.75-.75h.163c.355 0 .676.186.959.401.29.221.634.349 1.003.349 1.036 0 1.875-1.007 1.875-2.25s-.84-2.25-1.875-2.25c-.369 0-.713.128-1.003.349-.283.215-.604.401-.959.401h-.163a.75.75 0 01-.75-.75v-.163z"/>
            </svg>
          </div>
          <div class="ml-4 text-white">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-200 block">Docencia</span>
            <span class="text-base font-black tracking-tight text-white">Cuerpo Académico</span>
          </div>
        </div>

        <div class="p-7">
          <div class="inline-block px-2.5 py-1 rounded-full bg-slate-100 text-slate-800 border border-slate-200 text-xs font-bold uppercase mb-3">
            Magíster y Doctorado
          </div>
          <h3 class="font-extrabold text-[#1b365d] text-lg mb-2">Profesores Especializados</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Docentes con formación avanzada y trayectoria activa en la industria de desarrollo de software, ciberseguridad, gestión de bases de datos y ciencia de datos aplicada.
          </p>
        </div>
      </div>

      <div class="p-6 pt-0 border-t border-slate-100 flex items-center justify-between text-xs mt-4">
        <span class="text-slate-500 font-medium">Portal Académico</span>
        <a href="#referencias" class="text-[#004b93] font-bold hover:underline" title="Fuente F01">[F01: UTEM]</a>
      </div>
    </div>
  </div>
</section>
