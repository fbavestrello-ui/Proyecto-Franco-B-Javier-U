---
import { getCollection } from 'astro:content';

const refEntries = await getCollection('referencias');
const fuentes = refEntries[0]?.data.fuentes.sort((a, b) => a.id_fuente.localeCompare(b.id_fuente)) ?? [];
---
<section id="referencias" class="py-24 bg-[#001428] text-white border-t border-sky-950 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/20 border border-amber-400/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
        Rigor Académico y Trazabilidad
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Matriz de Fuentes Oficiales (Normas APA 7)
      </h2>
      <p class="mt-4 text-slate-300 text-xs sm:text-sm leading-relaxed">
        Cada porcentaje, métrica salarial o afirmación del sitio está respaldada y evaluada exhaustivamente bajo los 5 criterios del encargo: <strong class="text-white">Autoridad, Vigencia, Trazabilidad, Objetividad y Pertinencia</strong>.
      </p>
    </div>

    <div class="space-y-5">
      {fuentes.map((f) => (
        <article class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 text-xs leading-relaxed shadow-lg hover:border-sky-700/60 transition-colors" id={`ref-${f.id_fuente}`}>
          <!-- Cabecera de la Fuente -->
          <div class="flex flex-wrap items-center justify-between gap-3 mb-3 pb-3 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <span class="font-mono font-black text-amber-400 bg-amber-400/10 px-3 py-1 rounded-lg border border-amber-400/30 text-sm">
                [{f.id_fuente}]
              </span>
              <h3 class="font-bold text-white text-sm sm:text-base">
                {f.titulo}
              </h3>
            </div>
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-800 text-cyan-300 border border-slate-700">
              Fuente {f.tipo}
            </span>
          </div>

          <!-- Cita Formal APA 7 -->
          <p class="text-slate-300 font-medium mb-4 italic pl-2 border-l-2 border-amber-400/60 bg-white/5 py-2 pr-2 rounded-r-lg">
            {f.cita_apa}
          </p>

          <!-- Evaluación de los 5 Criterios Oficiales -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-3 text-[11px] text-slate-300 bg-black/40 p-4 rounded-xl border border-white/5">
            <div>
              <strong class="text-amber-400 block mb-1 uppercase tracking-wider text-[10px]">1. Autoridad</strong>
              <span>{f.evaluacion.autoridad}</span>
            </div>
            <div>
              <strong class="text-amber-400 block mb-1 uppercase tracking-wider text-[10px]">2. Vigencia</strong>
              <span>{f.evaluacion.vigencia}</span>
            </div>
            <div>
              <strong class="text-amber-400 block mb-1 uppercase tracking-wider text-[10px]">3. Trazabilidad</strong>
              <span>{f.evaluacion.trazabilidad}</span>
            </div>
            <div>
              <strong class="text-amber-400 block mb-1 uppercase tracking-wider text-[10px]">4. Objetividad</strong>
              <span>{f.evaluacion.objetividad}</span>
            </div>
            <div>
              <strong class="text-amber-400 block mb-1 uppercase tracking-wider text-[10px]">5. Pertinencia</strong>
              <span>{f.evaluacion.pertinencia}</span>
            </div>
          </div>

          <!-- Fecha de consulta y enlace trazable -->
          <div class="mt-4 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400 pt-2">
            <span>Fecha de auditoría y consulta: <strong class="text-slate-300">{f.fecha_consulta}</strong></span>
            <a href={f.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-cyan-300 hover:text-white underline font-semibold transition">
              Abrir enlace oficial de verificación &nearr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
